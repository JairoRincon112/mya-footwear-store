# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

APP_DEBUG=false
APP_TIMEZONE=America/Bogota

# Base de datos (MySQL / MariaDB de XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mya_footwear
DB_USER=root
DB_PASS=

# Clave secreta para firmar los tokens JWT (mínimo 32 caracteres, aleatoria)
JWT_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
# Duración del token en segundos (28800 = 8 horas)
JWT_TTL=28800

# Orígenes del frontend que pueden llamar a la API (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Tamaño máximo de las imágenes de productos, en megabytes
UPLOAD_MAX_MB=5

# Dirección del frontend (para los enlaces que van en los correos)
FRONTEND_URL=http://localhost/mya

# Correo: "log" guarda los correos en backend/storage/correos (desarrollo);
# "mail" los envía con sendmail de XAMPP (ver README para configurarlo con Gmail).
MAIL_DRIVER=log
MAIL_FROM=no-responder@myafootwear.com
MAIL_FROM_NAME=MyA FOOTWEAR STORE

# Pasarela de pagos Wompi (https://comercios.wompi.co -> Desarrolladores).
# Usa las llaves de PRUEBAS (sandbox) mientras desarrollas: no mueven dinero real.
# Si las llaves están vacías, el botón "Pagar con Wompi" informa que no está disponible.
WOMPI_ENTORNO=sandbox
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=