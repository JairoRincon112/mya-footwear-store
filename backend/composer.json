{
    "name": "mya/footwear-api",
    "description": "API REST de MyA FOOTWEAR STORE en PHP puro con arquitectura MVC",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpmd/phpmd": "^2.15",
        "squizlabs/php_codesniffer": "^3.13",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "pruebas": "phpunit",
        "analisis": [
            "phpstan analyse --no-progress --memory-limit=512M",
            "phpmd src,bin text phpmd.xml",
            "phpcs"
        ]
    }
}
