<?xml version="1.0"?>
<!-- Solo para medir: reporta la complejidad ciclomática de TODOS los métodos (umbral 1). -->
<ruleset name="MyA-complejidad"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Medición de complejidad ciclomática por método</description>
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <property name="reportLevel" value="1" />
            <property name="showClassesComplexity" value="false" />
        </properties>
    </rule>
</ruleset>
